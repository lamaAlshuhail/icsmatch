{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m ruff check src tests",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m mypy src",
      "problemMatcher": []
    },
    {
      "label": "check all",
      "dependsOrder": "sequence",
      "dependsOn": ["test", "lint", "typecheck"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "fetch CSAF corpus",
      "type": "shell",
      "command": "git clone --depth 1 https://github.com/cisagov/CSAF.git",
      "problemMatcher": []
    }
  ]
}
